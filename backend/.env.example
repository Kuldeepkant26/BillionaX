PORT=5001
NODE_ENV=development

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/galaxywave?retryWrites=true&w=majority

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_REFRESH_MAX_AGE_DAYS=30

CLIENT_URL=http://localhost:5173

# Extra allowed origins, comma-separated. In development any private-network
# address is accepted automatically, so phones on the same Wi-Fi just work.
# In production, list the real domains here.
CLIENT_ORIGINS=http://localhost:5173

# OTP: any code is accepted while OTP_DEV_BYPASS is true.
# This is forced OFF whenever NODE_ENV=production, regardless of this value.
# Which identifier guests sign in with: "email" or "phone".
# The phone path is fully intact — set this to "phone" to switch back.
OTP_CHANNEL=email

OTP_PROVIDER=smsmode
OTP_DEV_BYPASS=true
OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=4

# Country code prepended to the stored 10-digit number when sending.
OTP_COUNTRY_CODE=91

# Transactional email (Brevo). Carries the guest login code, so it is REQUIRED
# in production whenever OTP_CHANNEL=email — the server refuses to boot without
# it, since nobody could sign in.
#
# EMAIL_FROM must be a sender verified in Brevo (Senders, Domains & Dedicated
# IPs -> Senders), otherwise every send is rejected.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=BillionaX
EMAIL_TIMEOUT_MS=10000

# SMS gateway (smsmode). Optional in development: without a key the OTP is
# logged to the console instead of sent. REQUIRED in production — the server
# refuses to boot without it, since nobody could sign in.
#
# Create a key at smsmode -> Settings -> API keys. It can send messages at
# your expense — keep it server-side, never in the frontend.
# SMSMODE_SENDER is optional: only set it to a Sender ID registered under
# Settings -> Senders IDs, otherwise leave it blank for smsmode's default.
SMSMODE_API_KEY=
SMSMODE_BASE_URL=https://rest.smsmode.com/sms/v1
SMSMODE_SENDER=
SMSMODE_TIMEOUT_MS=10000

# Media uploads (Cloudinary). Optional: without these the app runs normally
# and upload endpoints report themselves unavailable.
#
# All three are on your Cloudinary dashboard under "Product Environment
# Credentials". The API secret can delete anything in the library — keep it
# server-side, never in the frontend.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=billionax

# Payments (Razorpay). Optional, and the absence of these keys is a supported
# mode rather than a broken one: with no key pair the platform runs in DEMO
# mode, where bills are composed, paid and recorded exactly as they would be
# live, with no network call and no money moving. Nothing in the UI or the
# business logic branches on this — only the payment provider differs — so a
# demo is indistinguishable from the real thing to whoever is watching.
#
# The key secret signs orders and can move money: server-side only. The key ID
# is public and appears in the browser's checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Signature secret for webhooks, from the Razorpay dashboard. REQUIRED in
# production whenever a key pair is present: the server refuses to boot without
# it, because the webhook is what confirms a payment and an unverifiable one
# cannot be trusted.
RAZORPAY_WEBHOOK_SECRET=
# The platform's own Route account, which hotel transfers are made from.
RAZORPAY_ACCOUNT_NUMBER=
RAZORPAY_BASE_URL=https://api.razorpay.com/v1
RAZORPAY_TIMEOUT_MS=15000

# Encrypts hotel bank credentials at rest (AES-256-GCM). Optional until you
# store your first credential, at which point it becomes required.
#
# 32 bytes as 64 hex characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# This MUST come from the environment and never from the database — a key kept
# beside the ciphertext it protects is obfuscation, not encryption. Changing it
# makes every existing stored credential permanently unreadable, so rotation
# needs a re-encrypt migration, not just a new value here.
CREDENTIAL_ENCRYPTION_KEY=

SEED_ADMIN_NAME=Platform Owner
SEED_ADMIN_EMAIL=admin@billionax.com
SEED_ADMIN_PASSWORD=
