PORT=5001
NODE_ENV=development

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/galaxywave?retryWrites=true&w=majority

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_REFRESH_MAX_AGE_DAYS=30

CLIENT_URL=http://localhost:5173

# Extra allowed origins, comma-separated. In development any private-network
# address is accepted automatically, so phones on the same Wi-Fi just work.
# In production, list the real domains here.
CLIENT_ORIGINS=http://localhost:5173

# OTP: any code is accepted while OTP_DEV_BYPASS is true.
# This is forced OFF whenever NODE_ENV=production, regardless of this value.
OTP_PROVIDER=console
OTP_DEV_BYPASS=true
OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=4

# Media uploads (Cloudinary). Optional: without these the app runs normally
# and upload endpoints report themselves unavailable.
#
# All three are on your Cloudinary dashboard under "Product Environment
# Credentials". The API secret can delete anything in the library — keep it
# server-side, never in the frontend.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=billionax

SEED_ADMIN_NAME=Platform Owner
SEED_ADMIN_EMAIL=admin@billionax.com
SEED_ADMIN_PASSWORD=
